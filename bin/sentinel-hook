#!/bin/sh
"exec" "python3" "$0" "$@"
# -*- coding: utf-8 -*-
"""
sentinel-hook — Universal AI Agent Hook Relay for loggdin (formerly Agent Sentinel)
Compatible with Claude Code, Cowork, Antigravity, Codex, Cursor, Gemini CLI, and Shells.
Reference: https://github.com/Louis-CFM/coucou architecture
"""

import sys
import json
import os
import socket
import urllib.request
import urllib.error
import re

# Event name normalization mapping
EVENT_MAP = {
    'BeforeTool': 'PreToolUse',
    'BeforeToolSelection': 'PreToolUse',
    'AfterTool': 'PostToolUse',
    'AfterModel': 'PostToolUse',
    'BeforeAgent': 'UserPromptSubmit',
    'AfterAgent': 'Stop',
    'startup': 'SessionStart',
    'exit': 'SessionEnd',
    'PreInvocation': 'UserPromptSubmit',
    'PostInvocation': 'PostToolUse',
    'pre_tool_use': 'PreToolUse',
    'post_tool_use': 'PostToolUse',
    'user_prompt_submit': 'UserPromptSubmit',
    'session_start': 'SessionStart',
    'session_end': 'SessionEnd',
    'stop': 'Stop',
    'sessionStart': 'SessionStart',
    'userPromptSubmitted': 'UserPromptSubmit',
    'agentStop': 'Stop',
    'notification': 'Notification',
    'preToolUse': 'PreToolUse',
    'postToolUse': 'PostToolUse',
    'permissionRequest': 'PermissionRequest',
    'PermissionRequest': 'PermissionRequest',
    'sessionEnd': 'SessionEnd',
}

def normalize_event(name):
    return EVENT_MAP.get(name, name)

def normalize_tool_fields(payload):
    # Tool Name
    if 'tool_name' not in payload:
        if payload.get('toolName'):
            payload['tool_name'] = payload['toolName']
        else:
            tool = payload.get('toolCall')
            if isinstance(tool, dict):
                name = tool.get('name') or payload.get('tool', '')
                if name:
                    payload['tool_name'] = name
            elif payload.get('tool'):
                payload['tool_name'] = payload['tool']

    # Tool Input / Command
    if 'tool_input' not in payload:
        tool_args = payload.get('toolArgs')
        if isinstance(tool_args, dict):
            payload['tool_input'] = tool_args
        else:
            tool = payload.get('toolCall') or {}
            if isinstance(tool.get('args'), dict):
                flat = dict(tool['args'])
                for src, dst in [('CommandLine', 'command'), ('FilePath', 'file_path'),
                                 ('Path', 'path'), ('Url', 'url'), ('Query', 'query'), ('Pattern', 'pattern')]:
                    if src in flat:
                        flat[dst] = flat[src]
                payload['tool_input'] = flat

    # Session ID
    if 'session_id' not in payload:
        for k in ['conversationId', 'conversation_id', 'sessionId', 'GEMINI_SESSION_ID']:
            if payload.get(k):
                payload['session_id'] = payload[k]
                break
        if 'session_id' not in payload:
            sid = os.environ.get('GEMINI_SESSION_ID', '')
            if sid:
                payload['session_id'] = sid

def resolve_directory(payload):
    tool = payload.get('toolCall') or {}
    tool_args = tool.get('args') if isinstance(tool.get('args'), dict) else (payload.get('tool_input') or {})
    cwd = None
    if isinstance(tool_args, dict):
        cwd = tool_args.get('Cwd') or tool_args.get('cwd') or tool_args.get('DirectoryPath')
        if not cwd:
            for k in ['AbsolutePath', 'TargetFile', 'FilePath', 'file_path', 'path', 'SearchPath']:
                val = tool_args.get(k)
                if val:
                    val_str = str(val)
                    if os.path.isdir(val_str):
                        cwd = val_str
                    else:
                        cwd = os.path.dirname(val_str)
                    break

    if not cwd and payload.get('workspacePaths') and len(payload['workspacePaths']) > 0:
        cwd = payload['workspacePaths'][0]

    if not cwd:
        for k in ['workdir', 'directory', 'workspaceRoot', 'cwd']:
            if payload.get(k):
                cwd = payload[k]
                break

    if not cwd or cwd == '.':
        cwd = os.getcwd()

    cwd_str = str(cwd)
    home = os.path.expanduser('~')
    if cwd_str == home:
        return '~'
    if cwd_str.startswith(home + '/'):
        return '~/' + cwd_str[len(home) + 1:]
    return cwd_str

def extract_modifies_files(payload, tool_name):
    t_lower = (tool_name or '').lower()

    # Read-only tools NEVER modify files
    read_only_tools = ['view_file', 'grep_search', 'list_dir', 'read_url_content', 'read_resource', 'list_resources', 'inspect_']
    if any(r in t_lower for r in read_only_tools):
        return "No (Read only)"

    tool = payload.get('toolCall') or {}
    args = tool.get('args') if isinstance(tool.get('args'), dict) else (payload.get('tool_input') or {})
    if isinstance(args, dict):
        for k in ['TargetFile', 'file_path', 'FilePath']:
            if args.get(k):
                val = str(args[k])
                home = os.path.expanduser('~')
                if val == home:
                    return '~'
                if val.startswith(home + '/'):
                    return '~/' + val[len(home) + 1:]
                return val

    if tool_name == 'run_command':
        cmd = extract_command(payload).lower()
        if any(w in cmd for w in ['rm ', 'rmdir', 'mkdir', 'touch', 'mv ', 'cp ', 'git checkout', 'git reset', 'git apply', 'npm i', 'pip install']):
            return 'Yes, via shell command'
        return 'No (Command execution)'

    return 'No'

DEDUP_CACHE_FILE = '/tmp/sentinel_dedup.json'

def check_recent_dedup(tool_name, command):
    try:
        if os.path.exists(DEDUP_CACHE_FILE):
            with open(DEDUP_CACHE_FILE, 'r') as f:
                entries = json.load(f)
                if not isinstance(entries, dict):
                    return False
                import time
                now = time.time()
                key1 = f"{tool_name}:{command}"
                key2 = f"cmd:{command.strip().lower()}"
                ts1 = entries.get(key1, 0)
                ts2 = entries.get(key2, 0)
                if (now - ts1 < 15.0) or (now - ts2 < 15.0):
                    return True
    except Exception:
        pass
    return False

def record_recent_dedup(tool_name, command):
    try:
        import time
        now = time.time()
        entries = {}
        if os.path.exists(DEDUP_CACHE_FILE):
            try:
                with open(DEDUP_CACHE_FILE, 'r') as f:
                    entries = json.load(f)
                    if not isinstance(entries, dict):
                        entries = {}
            except Exception:
                entries = {}
        entries = {k: v for k, v in entries.items() if now - v < 30.0}
        entries[f"{tool_name}:{command}"] = now
        entries[f"cmd:{command.strip().lower()}"] = now
        with open(DEDUP_CACHE_FILE, 'w') as f:
            json.dump(entries, f)
    except Exception:
        pass

def extract_command(payload):
    tool = payload.get('toolCall') or {}
    tool_args = tool.get('args') if isinstance(tool.get('args'), dict) else (payload.get('tool_input') or {})
    if isinstance(tool_args, dict):
        if 'command' in tool_args:
            return str(tool_args['command'])
        if 'CommandLine' in tool_args:
            return str(tool_args['CommandLine'])
        if 'file_path' in tool_args:
            return f"Edit {tool_args.get('file_path')}"
        if 'TargetFile' in tool_args:
            return f"Write {tool_args.get('TargetFile')}"
        if 'AbsolutePath' in tool_args:
            return f"Inspect {tool_args.get('AbsolutePath')}"
        if 'url' in tool_args:
            return f"Fetch {tool_args.get('url')}"

    cmd = payload.get('command') or payload.get('tool_name') or 'Execute Tool'
    return str(cmd)

def determine_risk(command, tool_name):
    cmd_lower = (command or '').lower()
    t_lower = (tool_name or '').lower()
    tokens = cmd_lower.split()
    first_token = tokens[0] if tokens else ''

    # Dangerous destructive or privilege escalation operations
    is_rm_rf = 'rm' in tokens and any(flag in tokens for flag in ['-rf', '-fr', '-r'])
    is_sudo = first_token == 'sudo' or ' sudo ' in cmd_lower or '; sudo ' in cmd_lower or '&& sudo ' in cmd_lower or '| sudo ' in cmd_lower
    is_dd = (first_token == 'dd' or ' dd if=' in cmd_lower) and ('of=/dev/' in cmd_lower or 'of=/dev/r' in cmd_lower or 'bs=' in cmd_lower)
    is_disk_destructive = any(p in cmd_lower for p in ['mkfs', 'shutdown', '> /dev/sd', 'drop database', 'drop table', 'truncate table', 'chmod -r 777', 'chown -r'])
    is_fork_bomb = ':(){ :|:& };:' in cmd_lower

    if is_rm_rf or is_sudo or is_dd or is_disk_destructive or is_fork_bomb:
        return 'high'

    # Medium risk: operations that modify repository state or install packages
    is_pkg_install = any(cmd in cmd_lower for cmd in ['npm install', 'npm i ', 'pip install', 'brew install', 'gem install', 'cargo install'])
    is_git_mod = 'git push' in cmd_lower or 'git reset' in cmd_lower or 'git commit' in cmd_lower or 'git branch -d' in cmd_lower
    is_file_mod = t_lower in ['write_to_file', 'replace_file_content', 'multi_replace_file_content']

    if is_pkg_install or is_git_mod or is_file_mod:
        return 'medium'

    return 'low'

SECRET_PATTERNS = [
    (r'sk-ant-[a-zA-Z0-9_\-]{30,}', 'Anthropic API Key'),
    (r'sk-(?:proj-)?[a-zA-Z0-9_\-]{30,}', 'OpenAI API Key'),
    (r'gh[pousr]_[a-zA-Z0-9]{36,}', 'GitHub Access Token'),
    (r'github_pat_[a-zA-Z0-9_]{50,}', 'GitHub Personal Access Token'),
    (r'AKIA[0-9A-Z]{16}', 'AWS Access Key ID'),
    (r'xox[baprs]-[0-9a-zA-Z]{10,48}', 'Slack Token'),
    (r'-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----', 'Private SSH/RSA Key'),
    (r'(?:bearer|token)\s+[a-zA-Z0-9_\-\.]{30,}', 'Bearer Token/Secret')
]

def scan_for_secrets(text):
    if not text:
        return []
    warnings = []
    text_str = str(text)
    for pattern, name in SECRET_PATTERNS:
        if re.search(pattern, text_str, re.IGNORECASE):
            warnings.append(f"Secret detected: {name}")
    return list(set(warnings))

def extract_diff_preview(payload, tool_name):
    t_lower = (tool_name or '').lower()
    tool = payload.get('toolCall') or {}
    args = tool.get('args') if isinstance(tool.get('args'), dict) else (payload.get('tool_input') or {})
    if not isinstance(args, dict):
        return None

    if 'replace_file_content' in t_lower:
        target = str(args.get('TargetContent', ''))
        replacement = str(args.get('ReplacementContent', ''))
        lines = []
        for l in target.splitlines()[:6]:
            lines.append(f"- {l}")
        for l in replacement.splitlines()[:6]:
            lines.append(f"+ {l}")
        return "\n".join(lines) if lines else None

    if 'multi_replace_file_content' in t_lower:
        chunks = args.get('ReplacementChunks', [])
        lines = []
        for ch in chunks[:2]:
            t = str(ch.get('TargetContent', ''))
            r = str(ch.get('ReplacementContent', ''))
            for l in t.splitlines()[:3]:
                lines.append(f"- {l}")
            for l in r.splitlines()[:3]:
                lines.append(f"+ {l}")
        return "\n".join(lines) if lines else None

    if 'write_to_file' in t_lower:
        content = str(args.get('CodeContent', ''))
        lines = [f"+ {l}" for l in content.splitlines()[:8]]
        if len(content.splitlines()) > 8:
            lines.append(f"+ ... ({len(content.splitlines()) - 8} more lines)")
        return "\n".join(lines) if lines else None

    if tool_name == 'run_command':
        cmd = extract_command(payload)
        lines = cmd.splitlines()
        if len(lines) > 1:
            return "\n".join(lines[:8])

    return None

def calculate_blast_radius(payload, tool_name, command):
    t_lower = (tool_name or '').lower()
    cmd_lower = (command or '').lower()

    if any(r in t_lower for r in ['view_file', 'grep_search', 'list_dir', 'read_url_content', 'read_resource']):
        return "0 files (read-only)"

    if 'replace_file_content' in t_lower:
        return "1 file (in-place modification)"

    if 'write_to_file' in t_lower:
        return "1 file (create or overwrite)"

    if tool_name == 'run_command':
        if 'rm -rf' in cmd_lower or 'rm -r' in cmd_lower or 'rmdir' in cmd_lower:
            return "Directory tree (permanent deletion)"
        if 'git reset --hard' in cmd_lower or 'git checkout .' in cmd_lower:
            return "All uncommitted working files"
        if 'git push' in cmd_lower:
            return "Remote git repository"
        if any(pkg in cmd_lower for pkg in ['npm i', 'npm install', 'pip install', 'brew install']):
            return "Project dependencies & lockfile"
        return "Terminal shell execution"

    return "Workspace"

SENSITIVE_TARGETS = ['/.ssh', '/.aws', '/.gnupg', '/etc/', '/private/etc', '/var/root', '/Library/Keychains']

def check_workspace_jail(payload, modifies_files, command):
    warnings = []
    text_to_check = f"{modifies_files} {command}"

    # Check for sensitive system paths
    for s in SENSITIVE_TARGETS:
        if s in text_to_check:
            warnings.append(f"Jail Violation: Operation targets sensitive credential path ({s})")

    # Check for workspace containment if workspace root is known
    workspaces = payload.get('workspacePaths') or []
    if workspaces and len(workspaces) > 0:
        ws_root = os.path.abspath(os.path.expanduser(workspaces[0]))
        if modifies_files and (modifies_files.startswith('/') or modifies_files.startswith('~') or modifies_files.startswith('.')):
            lower_m = modifies_files.lower()
            if not any(k in lower_m for k in ['no (', 'workspace', 'terminal']):
                expanded_mod = os.path.abspath(os.path.expanduser(modifies_files))
                if not expanded_mod.startswith(ws_root) and not expanded_mod.startswith('/tmp') and not expanded_mod.startswith('/var/folders'):
                    warnings.append(f"Jail Violation: File target escapes workspace root ({modifies_files})")

    return warnings

def load_workspace_policy(payload):
    workspaces = payload.get('workspacePaths') or []
    candidate_dirs = list(workspaces)
    cwd = payload.get('cwd') or os.getcwd()
    candidate_dirs.append(cwd)

    for d in candidate_dirs:
        if not d:
            continue
        policy_path = os.path.join(os.path.expanduser(d), '.loggdin.json')
        if os.path.exists(policy_path):
            try:
                with open(policy_path, 'r') as f:
                    return json.load(f)
            except Exception:
                pass
    return None

def send_via_socket(payload, socket_path, timeout=118):
    if not os.path.exists(socket_path):
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"SOCKET NOT FOUND: {socket_path}\n")
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(socket_path)
        msg = (json.dumps(payload) + '\n').encode('utf-8')
        s.sendall(msg)

        chunks = []
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            chunks.append(chunk)
            if b'\n' in chunk:
                break
        s.close()
        response = b''.join(chunks).decode('utf-8').strip()
        if response:
            return json.loads(response)
    except Exception as e:
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"SOCKET EXCEPTION: {e}\n")
        return None
    return None

def send_via_http(payload, port=9191, timeout=120):
    url = f"http://127.0.0.1:{port}/ask"
    req_body = json.dumps(payload).encode('utf-8')
    headers = {'Content-Type': 'application/json'}
    try:
        token_path = os.path.expanduser('~/.loggdin/token')
        if not os.path.exists(token_path):
            token_path = os.path.expanduser('~/Library/Application Support/AgentSentinel/token')
        if os.path.exists(token_path):
            with open(token_path) as f:
                headers['X-Loggdin-Token'] = f.read().strip()
    except Exception:
        pass
    req = urllib.request.Request(
        url,
        data=req_body,
        headers=headers,
        method='POST'
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = resp.read()
            return json.loads(data.decode('utf-8'))
    except Exception as e:
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"HTTP EXCEPTION: {e}\n")
        return None

def main():
    # Parse CLI flags
    args = sys.argv[1:]
    agent = 'claude-code'
    event_arg = None
    is_ask_mode = False

    i = 0
    while i < len(args):
        a = args[i]
        if a == '--agent' and i + 1 < len(args):
            agent = args[i + 1]
            i += 2
        elif a == '--ask':
            is_ask_mode = True
            i += 1
        elif not a.startswith('--') and event_arg is None:
            event_arg = a
            i += 1
        else:
            i += 1

    payload = {}
    raw = b''
    # Read stdin payload if available
    try:
        if not sys.stdin.isatty():
            raw = sys.stdin.buffer.read()
            if raw:
                payload = json.loads(raw.decode('utf-8'))
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"INVOKED: args={sys.argv}, raw={raw[:200]}\n")
    except Exception as e:
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"STDIN ERROR: {e}\n")

    event = event_arg or payload.get('hook_event_name') or payload.get('event') or 'PermissionRequest'
    event = normalize_event(event)
    payload['hook_event_name'] = event
    payload['requestedBy'] = payload.get('requestedBy') or agent
    normalize_tool_fields(payload)

    with open('/tmp/sentinel_hook.log', 'a') as f:
        f.write(f"EVENT: {event}, keys={list(payload.keys())}, tool_name={payload.get('tool_name')}, toolCall={payload.get('toolCall')}\n")

    # Interactive question tools (AskUserQuestion, ask_question, etc.) are designed for direct user interaction in the host app.
    # Auto-allow immediately so the native IDE/terminal input modal appears seamlessly with full keyboard focus.
    t_name = payload.get('tool_name') or payload.get('toolCall', {}).get('name') or ''
    t_name_lower = t_name.lower()
    interactive_question_tools = {
        'askuserquestion', 'ask_question', 'ask_user', 'question',
        'prompt_user', 'confirm', 'user_input', 'input', 'interactive_prompt'
    }
    if t_name_lower in interactive_question_tools or 'question' in t_name_lower:
        if agent == 'antigravity':
            out = {'decision': 'allow'}
        else:
            out = {'hookSpecificOutput': {'hookEventName': 'PermissionRequest', 'decision': {'behavior': 'allow'}}}
        sys.stdout.write(json.dumps(out) + '\n')
        sys.stdout.flush()
        sys.exit(0)

    socket_path = os.path.expanduser('~/Library/Application Support/AgentSentinel/sentinel.sock')

    # If event is PermissionRequest or PreToolUse requiring gating:
    if event == 'PermissionRequest' or (agent == 'antigravity' and event == 'PreToolUse'):
        # For Antigravity IDE: safe read-only operations do not require confirmation
        safe_read_tools = {
            'view_file', 'list_dir', 'grep_search', 'read_url_content',
            'read_resource', 'list_resources', 'schedule', 'manage_task'
        }
        if agent == 'antigravity':
            if t_name in safe_read_tools:
                out = {'decision': 'allow'}
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)
            if t_name == 'run_command':
                cmd_check = extract_command(payload).strip().lower()
                safe_cmds = (
                    'git status', 'git diff', 'git log', 'git branch', 'git rev-parse',
                    'pwd', 'which ', 'echo ', 'ls ', 'swift build', 'swift test',
                    './packaging/create_dmg.sh', 'hdiutil', 'pkill loggdin', 'open /Applications/Loggdin.app',
                    'curl -s http://127.0.0.1:9191', 'curl -i -s http://127.0.0.1:9191', './bin/loggdin status'
                )
                if any(cmd_check == c.strip() or cmd_check.startswith(c) for c in safe_cmds):
                    out = {'decision': 'allow'}
                    sys.stdout.write(json.dumps(out) + '\n')
                    sys.stdout.flush()
                    sys.exit(0)

        command = extract_command(payload)
        risk = determine_risk(command, t_name)

        # Production Feature: Workspace Security Policy (.loggdin.json)
        policy = load_workspace_policy(payload)
        if policy:
            cmd_clean = command.strip().lower()
            blocked = policy.get('blockedCommands') or []
            if any(b.lower() in cmd_clean for b in blocked):
                out = {'decision': 'deny', 'reason': 'Action blocked by repository security policy (.loggdin.json)'}
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)

            allowed_cmds = policy.get('allowedCommands') or []
            if any(cmd_clean == a.lower() or cmd_clean.startswith(a.lower() + ' ') for a in allowed_cmds):
                out = {'decision': 'allow'}
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)

            require_touch = policy.get('requireTouchID') or []
            if any(t.lower() in cmd_clean for t in require_touch):
                risk = 'high'

        # Check deduplication cache: if the exact same (tool, command) was approved recently, auto-allow!
        if check_recent_dedup(t_name, command):
            out = {'decision': 'allow'}
            sys.stdout.write(json.dumps(out) + '\n')
            sys.stdout.flush()
            sys.exit(0)

        resolved_dir = resolve_directory(payload)
        modifies_files = extract_modifies_files(payload, t_name)

        # Production Feature: Scan for secrets in command and arguments
        tool_args_str = json.dumps(payload.get('toolCall', {})) + " " + json.dumps(payload.get('tool_input', {}))
        secret_warnings = scan_for_secrets(command + " " + tool_args_str)
        if secret_warnings:
            risk = 'high'

        # Production Feature: Path-based Workspace Jail Enforcement
        jail_warnings = check_workspace_jail(payload, modifies_files, command)
        if jail_warnings:
            secret_warnings.extend(jail_warnings)
            risk = 'high'

        # Production Feature: Extract interactive diff/payload preview
        diff_preview = extract_diff_preview(payload, t_name)

        # Production Feature: Calculate blast radius
        blast_radius = calculate_blast_radius(payload, t_name, command)

        ask_data = {
            'command': command,
            'title': f"Authorize {t_name}?" if agent == 'antigravity' else f"{agent.replace('-', ' ').title()} Request",
            'subtitle': f"Antigravity IDE • {t_name}" if agent == 'antigravity' else f"{agent.replace('-', ' ').title()} • {t_name}",
            'risk': risk,
            'requestedBy': 'Antigravity IDE' if agent == 'antigravity' else agent,
            'directory': resolved_dir,
            'modifiesFiles': modifies_files,
            'secretWarnings': secret_warnings,
            'diffPreview': diff_preview,
            'blastRadius': blast_radius,
            'symbol': 'sparkles' if agent == 'antigravity' else ('terminal.fill' if 'Bash' in t_name else 'pencil.and.outline'),
            'tool': t_name,
            'forcePrompt': False,
            'raw': payload
        }

        # Try Unix domain socket first, fallback to HTTP 127.0.0.1:9191
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"SENDING ASK: {ask_data.get('command')}, risk={risk}\n")
        resp = send_via_socket(ask_data, socket_path)
        with open('/tmp/sentinel_hook.log', 'a') as f:
            f.write(f"SOCKET RESP: {resp}\n")
        if not resp:
            resp = send_via_http(ask_data, port=int(os.environ.get('SENTINEL_PORT', 9191)))
            with open('/tmp/sentinel_hook.log', 'a') as f:
                f.write(f"HTTP RESP: {resp}\n")

        # If daemon was offline, automatically launch loggdin and retry once
        if not resp:
            try:
                for app_candidate in ['/Applications/Loggdin.app', '/Applications/AgentSentinel.app']:
                    if os.path.exists(app_candidate):
                        import subprocess, time
                        subprocess.run(['open', '-a', app_candidate], check=False)
                        time.sleep(0.8)
                        resp = send_via_socket(ask_data, socket_path) or send_via_http(ask_data, port=int(os.environ.get('SENTINEL_PORT', 9191)))
                        break
            except Exception:
                pass

        if resp:
            allowed = resp.get('allowed', False)
            decision = resp.get('decision', 'deny')
            scope = resp.get('scope', 'once')

            if allowed:
                record_recent_dedup(t_name, command)

            # Official Google Antigravity IDE Contract (docs/hooks.md)
            if agent == 'antigravity':
                if allowed:
                    out = {'decision': 'allow'}
                else:
                    out = {
                        'decision': 'deny',
                        'reason': 'Action denied by user in loggdin'
                    }
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)

            # OpenAI Codex / ChatGPT CLI Contract
            if agent in ('codex', 'chatgpt'):
                if allowed:
                    out = {'decision': 'allow', 'behavior': 'allow', 'status': 'approved'}
                else:
                    out = {'decision': 'deny', 'behavior': 'deny', 'status': 'rejected'}
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)

            # GitHub Copilot CLI Contract
            if agent in ('copilot', 'muse'):
                out = {'permissionDecision': 'allow' if allowed else 'deny', 'decision': 'allow' if allowed else 'deny'}
                sys.stdout.write(json.dumps(out) + '\n')
                sys.stdout.flush()
                sys.exit(0)

            # Claude Code & Universal Agents
            if allowed:
                out = {
                    'decision': 'allow',
                    'behavior': 'allow',
                    'hookSpecificOutput': {
                        'hookEventName': event,
                        'decision': {'behavior': 'allow'}
                    }
                }
                if scope == 'always' and payload.get('permission_suggestions'):
                    out['hookSpecificOutput']['decision']['updatedPermissions'] = payload.get('permission_suggestions')
            else:
                out = {
                    'decision': 'deny',
                    'behavior': 'deny',
                    'hookSpecificOutput': {
                        'hookEventName': event,
                        'decision': {
                            'behavior': 'deny',
                            'message': 'Action denied in loggdin'
                        }
                    }
                }
            sys.stdout.write(json.dumps(out) + '\n')
            sys.stdout.flush()
            sys.exit(0)

        # Fallback if server is not reachable: fail-open for all agents so developer isn't locked out
        if agent == 'antigravity':
            out = {'decision': 'allow'}
        elif agent in ('codex', 'chatgpt'):
            out = {'decision': 'allow', 'behavior': 'allow', 'status': 'approved'}
        elif agent in ('copilot', 'muse'):
            out = {'permissionDecision': 'allow', 'decision': 'allow'}
        else:
            out = {
                'decision': 'allow',
                'behavior': 'allow',
                'hookSpecificOutput': {
                    'hookEventName': event,
                    'decision': {'behavior': 'allow'}
                }
            }
        sys.stdout.write(json.dumps(out) + '\n')
        sys.stdout.flush()
        sys.exit(0)

    # For other events (SessionStart, PostToolUse, Stop, SessionEnd): notify Sentinel asynchronously
    try:
        notify_data = {
            'event': event,
            'agent': agent,
            'sessionId': payload.get('session_id', ''),
            'tool': payload.get('tool_name', ''),
            'command': extract_command(payload)
        }
        send_via_socket(notify_data, socket_path, timeout=1)
    except Exception:
        pass

    # Provide valid output according to agent contract
    if agent == 'antigravity':
        if event == 'PostToolUse':
            sys.stdout.write('{}\n')
        elif event == 'PreInvocation':
            sys.stdout.write(json.dumps({'injectSteps': []}) + '\n')
        elif event == 'Stop':
            sys.stdout.write(json.dumps({'decision': ''}) + '\n')
        else:
            sys.stdout.write('{}\n')
        sys.stdout.flush()

    sys.exit(0)

if __name__ == '__main__':
    main()
