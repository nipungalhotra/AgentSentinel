#!/usr/bin/env bash

# loggdin Universal CLI & Agent Dispatcher
# Supports: Claude Code, Cowork, Antigravity IDE, Cursor, Codex, ChatGPT, Copilot, and ZSH Shells.
# Modeled after Coucou (https://github.com/Louis-CFM/coucou) architecture

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_PATH="/Applications/Loggdin.app"
[ ! -d "$APP_PATH" ] && APP_PATH="/Applications/AgentSentinel.app"
[ ! -d "$APP_PATH" ] && APP_PATH="$ROOT_DIR/Loggdin.app"
[ ! -d "$APP_PATH" ] && APP_PATH="$ROOT_DIR/AgentSentinel.app"

MCP_SERVER="$ROOT_DIR/bin/sentinel-mcp.js"
HOOK_SCRIPT="$HOME/Library/Application Support/AgentSentinel/sentinel-hook"
PORT=9191

get_token() {
  if [ -f "$HOME/.loggdin/token" ]; then
    cat "$HOME/.loggdin/token"
  elif [ -f "$HOME/Library/Application Support/AgentSentinel/token" ]; then
    cat "$HOME/Library/Application Support/AgentSentinel/token"
  fi
}

ensure_daemon() {
  if ! curl -s --connect-timeout 1 "http://127.0.0.1:$PORT/status" > /dev/null 2>&1; then
    echo "🛡️ Starting loggdin daemon..."
    open -g -j "$APP_PATH" 2>/dev/null || open "$APP_PATH"
    for i in {1..12}; do
      if curl -s --connect-timeout 1 "http://127.0.0.1:$PORT/status" > /dev/null 2>&1; then
        break
      fi
      sleep 0.25
    done
  fi
}

deploy_hook_script() {
  mkdir -p "$HOME/Library/Application Support/AgentSentinel"
  cp "$ROOT_DIR/bin/sentinel-hook" "$HOOK_SCRIPT"
  chmod +x "$HOOK_SCRIPT"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$HOOK_SCRIPT" "$HOME/.local/bin/sentinel-hook"
}

cmd_status() {
  STATUS=$(curl -s --connect-timeout 2 "http://127.0.0.1:$PORT/status" 2>&1)
  if [ $? -eq 0 ]; then
    echo "🛡️ loggdin Status: ONLINE"
    echo "$STATUS"
  else
    echo "❌ loggdin Status: OFFLINE"
    echo "Run 'open $APP_PATH' to start."
  fi
}

cmd_mcp() {
  ensure_daemon
  node "$MCP_SERVER"
}

cmd_run() {
  if [ -z "$1" ]; then
    echo "Usage: loggdin run <command>"
    exit 1
  fi
  ensure_daemon

  COMMAND="$*"
  PAYLOAD=$(python3 -c "
import json, sys
data = {
    'command': sys.argv[1],
    'title': 'Execute Command?',
    'subtitle': 'Terminal • Shell Gate',
    'risk': 'medium',
    'requestedBy': 'Terminal',
    'tool': 'Bash',
    'symbol': 'terminal.fill',
    'forcePrompt': True
}
print(json.dumps(data))
" "$COMMAND")

  RESPONSE=$(curl -s -X POST "http://127.0.0.1:$PORT/ask" \
    -H "Content-Type: application/json" \
    -H "X-Loggdin-Token: $(get_token)" \
    -d "$PAYLOAD")

  ALLOWED=$(python3 -c "
import json, sys
try:
    res = json.loads(sys.argv[1])
    print(res.get('allowed', False))
except Exception:
    print(False)
" "$RESPONSE")

  if [ "$ALLOWED" = "True" ]; then
    echo "✓ Permitted by loggdin. Executing: $COMMAND"
    eval "$COMMAND"
  else
    echo "❌ Aborted by user in loggdin permission prompt."
    exit 1
  fi
}

cmd_test() {
  ensure_daemon
  AGENT="${1:-antigravity}"
  echo "🧪 Triggering live liquid glass notch permission prompt for: $AGENT"
  echo "   (Check beneath your MacBook notch or top of screen)"

  case "$AGENT" in
    antigravity)
      CMD="docker compose up -d antigravity-core --build"
      TITLE="Deploy Antigravity App Container?"
      SUBTITLE="Antigravity IDE • Agent Deployer"
      RISK="high"
      SYM="sparkles"
      ;;
    claude)
      CMD="rm -rf ./dist && npm run build"
      TITLE="Clean Build Artifacts?"
      SUBTITLE="Claude Code • Bash"
      RISK="medium"
      SYM="sparkles"
      ;;
    codex|chatgpt)
      CMD="python3 -m pip install -r requirements.txt"
      TITLE="Install Dependencies?"
      SUBTITLE="Codex • PipInstaller"
      RISK="low"
      SYM="curlybraces"
      ;;
    cursor)
      CMD="git push origin main --force"
      TITLE="Force Push to Main Branch?"
      SUBTITLE="Cursor • GitSync"
      RISK="high"
      SYM="chevron.left.forwardslash.chevron.right"
      ;;
    cowork)
      CMD="cat ~/.ssh/id_rsa | base64"
      TITLE="Read SSH Private Key?"
      SUBTITLE="Cowork • KeyAccess"
      RISK="high"
      SYM="app.badge.checkmark"
      ;;
    *)
      CMD="rm -rf /var/log/app && npm test"
      TITLE="Execute Destructive Cleanup?"
      SUBTITLE="Claude Code • Bash"
      RISK="high"
      SYM="terminal.fill"
      ;;
  esac

  curl -s -X POST "http://127.0.0.1:$PORT/ask" \
    -H "Content-Type: application/json" \
    -d "{\"command\":\"$CMD\",\"title\":\"$TITLE\",\"subtitle\":\"$SUBTITLE\",\"risk\":\"$RISK\",\"requestedBy\":\"$AGENT\",\"symbol\":\"$SYM\",\"forcePrompt\":true}"
  echo ""
}

cmd_pending() {
  ensure_daemon
  PENDING=$(curl -s "http://127.0.0.1:$PORT/pending")
  if [ "${1:-}" = "--json" ] || [ "${1:-}" = "-j" ]; then
    echo "$PENDING"
    return
  fi
  python3 -c "
import sys, json
try:
    d = json.loads(sys.argv[1])
    if d.get('hasPending'):
        print(f\"⚠️  Pending Permission Request\")
        print(f\"🤖 Agent:   {d.get('requestedBy')}\")
        print(f\"⚠️  Risk:    {d.get('risk', '').upper()}\")
        print(f\"💻 Action:  {d.get('command')}\")
    else:
        print(\"✓ No permissions currently pending.\")
except Exception as e:
    print(sys.argv[1])
" "$PENDING"
}

cmd_review() {
  ensure_daemon
  PENDING=$(curl -s "http://127.0.0.1:$PORT/pending")
  python3 -c "
import sys, json, os, subprocess

try:
    d = json.loads(sys.argv[1])
    if not d.get('hasPending'):
        print('✓ No permissions currently pending on your Mac.')
        sys.exit(0)
    
    print('========================================')
    print('🛡️  loggdin Remote Permission Review')
    print('========================================')
    print(f\"🤖 Agent:   {d.get('requestedBy')} ({d.get('subtitle', '')})\")
    print(f\"⚠️  Risk:    {d.get('risk', '').upper()}\")
    print(f\"💻 Action:  {d.get('command')}\")
    print('========================================')
    print('Select action:')
    print('  1) Allow for 10 minutes (Recommended)')
    print('  2) Allow once')
    print('  3) Deny')
    print('  q) Quit without deciding')
    print('----------------------------------------')
    
    choice = input('Choice [1/2/3/q]: ').strip().lower()
    port = '9191'
    
    token_val = ''
    try:
        import os
        tp = os.path.expanduser('~/.loggdin/token')
        if not os.path.exists(tp):
            tp = os.path.expanduser('~/Library/Application Support/AgentSentinel/token')
        if os.path.exists(tp):
            with open(tp) as f: token_val = f.read().strip()
    except Exception:
        pass

    auth_h = ['-H', f'X-Loggdin-Token: {token_val}'] if token_val else []

    if choice == '1':
        subprocess.run(['curl', '-s', '-X', 'POST', f'http://127.0.0.1:{port}/decision', 
                       '-H', 'Content-Type: application/json'] + auth_h + [
                       '-d', '{\"decision\":\"allow\",\"scope\":\"10m\"}'])
        print('✅ Approved for 10 minutes.')
    elif choice == '2':
        subprocess.run(['curl', '-s', '-X', 'POST', f'http://127.0.0.1:{port}/decision', 
                       '-H', 'Content-Type: application/json'] + auth_h + [
                       '-d', '{\"decision\":\"allow\",\"scope\":\"once\"}'])
        print('✅ Approved once.')
    elif choice == '3':
        subprocess.run(['curl', '-s', '-X', 'POST', f'http://127.0.0.1:{port}/decision', 
                       '-H', 'Content-Type: application/json'] + auth_h + [
                       '-d', '{\"decision\":\"deny\"}'])
        print('❌ Denied permission.')
    else:
        print('Cancelled.')
except Exception as e:
    print(f'Error: {e}')
" "$PENDING"
}

cmd_allow() {
  ensure_daemon
  SCOPE="${1:-once}"
  case "$SCOPE" in
    10m|10min|10minutes) SCOPE="10m" ;;
    always|all) SCOPE="always" ;;
    *) SCOPE="once" ;;
  esac
  RESP=$(curl -s -X POST "http://127.0.0.1:$PORT/decision" \
    -H "Content-Type: application/json" \
    -H "X-Loggdin-Token: $(get_token)" \
    -d "{\"decision\":\"allow\",\"scope\":\"$SCOPE\"}")
  echo "✓ Approved permission (Scope: $SCOPE)"
}

cmd_deny() {
  ensure_daemon
  RESP=$(curl -s -X POST "http://127.0.0.1:$PORT/decision" \
    -H "Content-Type: application/json" \
    -H "X-Loggdin-Token: $(get_token)" \
    -d "{\"decision\":\"deny\"}")
  echo "❌ Denied permission."
}

cmd_sound() {
  ensure_daemon
  SOUND_NAME="$1"
  if [ -n "$SOUND_NAME" ]; then
    RESP=$(curl -s -X POST "http://127.0.0.1:$PORT/sound" \
      -H "Content-Type: application/json" \
      -H "X-Loggdin-Token: $(get_token)" \
      -d "{\"sound\":\"$SOUND_NAME\"}")
    echo "🔔 Sound set to: $SOUND_NAME"
  else
    curl -s "http://127.0.0.1:$PORT/sound"
    echo ""
  fi
}

# Main command router
case "$1" in
  mcp)
    cmd_mcp
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  pending)
    shift
    cmd_pending "$@"
    ;;
  review)
    cmd_review
    ;;
  allow)
    shift
    cmd_allow "$@"
    ;;
  deny)
    cmd_deny
    ;;
  sound)
    shift
    cmd_sound "$@"
    ;;
  status)
    cmd_status
    ;;
  test)
    shift
    cmd_test "$@"
    ;;
  install)
    "$ROOT_DIR/bin/sentinel" install "$2"
    ;;
  help|--help|-h|"")
    echo "loggdin Universal CLI (Apple Shortcuts & Agent Guard)"
    echo ""
    echo "Usage:"
    echo "  loggdin allow [once|10m|always]  Approves active permission request (ideal for Apple Shortcuts)"
    echo "  loggdin deny                     Denies active permission request"
    echo "  loggdin pending                  Shows currently pending permission prompt"
    echo "  loggdin sound [Glass|Ping|Pop]   Gets or sets the notification sound"
    echo "  loggdin run <command>            Guards a command with the Liquid Glass notch popup"
    echo "  loggdin test <agent>             Tests live notch popup (antigravity, claude, codex, cursor, cowork)"
    echo "  loggdin mcp                      Runs the MCP server for Claude, Cowork, Cursor, Antigravity"
    echo "  loggdin status                   Displays daemon status"
    echo "  loggdin install <target>         Installs integration (antigravity, claude, cursor, codex, zsh, all)"
    ;;
  *)
    cmd_run "$@"
    ;;
esac
